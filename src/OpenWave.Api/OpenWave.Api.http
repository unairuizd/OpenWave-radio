@OpenWave.Api_HostAddress = http://localhost:5080

GET {{OpenWave.Api_HostAddress}}/api/health
Accept: application/json

###

# Today's music fact, the 14 previous days and what happened today in music (Spanish)
GET {{OpenWave.Api_HostAddress}}/api/facts/daily?days=15
Accept: application/json

###

# The same in English
GET {{OpenWave.Api_HostAddress}}/api/facts/daily
Accept: application/json
Accept-Language: en

###

# days outside 1-31: 400 with a localized detail
GET {{OpenWave.Api_HostAddress}}/api/facts/daily?days=0
Accept: application/json

###

# Top 50 stations by popularity
GET {{OpenWave.Api_HostAddress}}/api/stations
Accept: application/json

###

# Stations whose name contains "jazz" (case-insensitive)
GET {{OpenWave.Api_HostAddress}}/api/stations?name=jazz
Accept: application/json

###

# At most 5 stations (values above 100 are capped at 100)
GET {{OpenWave.Api_HostAddress}}/api/stations?limit=5
Accept: application/json

###

# Exact filters, ignoring case: country, one of the station's languages, and one of its tags
GET {{OpenWave.Api_HostAddress}}/api/stations?country=spain&language=spanish&tag=pop&limit=10
Accept: application/json

###

# Genre and content type together: every station has both the "jazz" and the "music" tags
GET {{OpenWave.Api_HostAddress}}/api/stations?tag=jazz&contentType=music&limit=10
Accept: application/json

###

# Name search with filters
GET {{OpenWave.Api_HostAddress}}/api/stations?name=radio&country=Spain&contentType=news&limit=10
Accept: application/json

###

# Unknown content type (400): "Tipo de contenido no válido."
GET {{OpenWave.Api_HostAddress}}/api/stations?contentType=podcast
Accept: application/json

###

# Filter options (countries, languages and genres are cached for 60 minutes)
GET {{OpenWave.Api_HostAddress}}/api/catalog/countries
Accept: application/json

###

GET {{OpenWave.Api_HostAddress}}/api/catalog/languages
Accept: application/json

###

GET {{OpenWave.Api_HostAddress}}/api/catalog/genres
Accept: application/json

###

# The four fixed content types (no Radio Browser request)
GET {{OpenWave.Api_HostAddress}}/api/catalog/content-types
Accept: application/json

###

# Create an account (201). Repeating it gives 409 "El correo ya está registrado."
POST {{OpenWave.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "secreta123"
}

###

# Invalid input (400): "El correo no es válido."
POST {{OpenWave.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "ana-at-example",
  "password": "secreta123"
}

###

# Log in (200). The email is trimmed and lower-cased, so the letter case does not matter
POST {{OpenWave.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "ANA@example.com",
  "password": "secreta123"
}

###

# Wrong password or unknown email (401): "Correo o contraseña incorrectos."
POST {{OpenWave.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "incorrecta"
}

###

# --- Favourites (use the "id" returned by register or login) ---
@userId = 1

# The user's favourites, newest first (200). Unknown user: 404 "El usuario no existe."
GET {{OpenWave.Api_HostAddress}}/api/users/{{userId}}/favorites
Accept: application/json

###

# Add a favourite (201). Repeating it gives 409 "La emisora ya está en tus favoritas."
POST {{OpenWave.Api_HostAddress}}/api/users/{{userId}}/favorites
Content-Type: application/json

{
  "id": "00000000-0000-0000-0000-000000000001",
  "name": "Radio de Ejemplo",
  "streamUrl": "https://example.com/stream.mp3",
  "country": "Spain",
  "language": "spanish",
  "tags": ["pop", "noticias"],
  "logoUrl": null
}

###

# Station without streamUrl (400): "Los datos de la emisora no son válidos."
POST {{OpenWave.Api_HostAddress}}/api/users/{{userId}}/favorites
Content-Type: application/json

{
  "id": "00000000-0000-0000-0000-000000000002",
  "name": "Sin URL"
}

###

# Remove a favourite (204). Repeating it gives 404 "La emisora no está en tus favoritas."
DELETE {{OpenWave.Api_HostAddress}}/api/users/{{userId}}/favorites/00000000-0000-0000-0000-000000000001

###
