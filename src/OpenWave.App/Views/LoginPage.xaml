<?xml version="1.0" encoding="UTF-8" ?>
<!--  Pushed on the section it was opened from (Favoritos, Inicio, Curiosidades or the welcome pop-up's page), so the
      back arrow returns there. The same shared header as the settings pages, without the gear: the platform bar is
      hidden so there is a single, themed back arrow.  -->
<ContentPage
    x:Class="OpenWave.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:OpenWave.App.Views.Controls"
    xmlns:loc="clr-namespace:OpenWave.App.Services.Localization"
    xmlns:views="clr-namespace:OpenWave.App.Views"
    xmlns:vm="clr-namespace:OpenWave.App.ViewModels"
    x:DataType="vm:LoginViewModel"
    Title="{loc:Translate Page_Login}"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <views:SettingsHeader Grid.Row="0" ShowGear="False" />

        <ScrollView Grid.Row="1">
            <controls:SizeLimit MinWidth="{DynamicResource FormMinWidth}" MaxWidth="{DynamicResource FormMaxWidth}">
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Entry
                        Keyboard="Email"
                        Placeholder="{loc:Translate Login_Email}"
                        Text="{Binding Email}" />
                    <Entry
                        IsPassword="True"
                        Placeholder="{loc:Translate Login_Password}"
                        ReturnCommand="{Binding LoginCommand}"
                        Text="{Binding Password}" />

                    <Label
                        IsVisible="{Binding HasError}"
                        Style="{StaticResource ErrorLabel}"
                        Text="{Binding ErrorMessage}" />

                    <Button Command="{Binding LoginCommand}" Text="{loc:Translate Page_Login}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                    <Label
                        Margin="0,12,0,0"
                        Style="{StaticResource SecondaryLabel}"
                        Text="{loc:Translate Login_NoAccount}" />
                    <Button Command="{Binding GoToRegisterCommand}" Text="{loc:Translate Page_Register}" />
                </VerticalStackLayout>
            </controls:SizeLimit>
        </ScrollView>
    </Grid>

</ContentPage>
