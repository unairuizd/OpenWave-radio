<?xml version="1.0" encoding="UTF-8" ?>
<!--  Pushed on top of Iniciar sesión, so the back arrow returns there. The same shared header as the settings pages,
      without the gear: the platform bar is hidden so there is a single, themed back arrow.  -->
<ContentPage
    x:Class="OpenWave.App.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:OpenWave.App.Views.Controls"
    xmlns:loc="clr-namespace:OpenWave.App.Services.Localization"
    xmlns:views="clr-namespace:OpenWave.App.Views"
    xmlns:vm="clr-namespace:OpenWave.App.ViewModels"
    x:DataType="vm:RegisterViewModel"
    Title="{loc:Translate Page_Register}"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <views:SettingsHeader Grid.Row="0" ShowGear="False" />

        <ScrollView Grid.Row="1">
            <controls:SizeLimit MinWidth="{DynamicResource FormMinWidth}" MaxWidth="{DynamicResource FormMaxWidth}">
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Entry
                        Keyboard="Email"
                        Placeholder="{loc:Translate Login_Email}"
                        Text="{Binding Email}" />
                    <Entry
                        IsPassword="True"
                        Placeholder="{loc:Translate Register_Password}"
                        Text="{Binding Password}" />
                    <Entry
                        IsPassword="True"
                        Placeholder="{loc:Translate Register_RepeatPassword}"
                        ReturnCommand="{Binding RegisterCommand}"
                        Text="{Binding ConfirmPassword}" />

                    <Label
                        IsVisible="{Binding HasError}"
                        Style="{StaticResource ErrorLabel}"
                        Text="{Binding ErrorMessage}" />

                    <Button Command="{Binding RegisterCommand}" Text="{loc:Translate Page_Register}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </controls:SizeLimit>
        </ScrollView>
    </Grid>

</ContentPage>
