<?xml version="1.0" encoding="UTF-8" ?>
<!--
    The look comes from the active theme layout (ReproductorTemplate); the page keeps only its view model.
    The app's single audio player is not here: it belongs to the window (MediaElementAudioPlayer), so leaving this
    page or changing the theme never stops or duplicates the audio.
-->
<ContentPage
    x:Class="OpenWave.App.Views.ReproductorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:OpenWave.App.Services"
    xmlns:vm="clr-namespace:OpenWave.App.ViewModels"
    x:DataType="vm:ReproductorViewModel"
    Title="Reproductor"
    services:AppNavigation.Section="Reproductor"
    ControlTemplate="{DynamicResource ReproductorTemplate}"
    Shell.NavBarIsVisible="False" />
