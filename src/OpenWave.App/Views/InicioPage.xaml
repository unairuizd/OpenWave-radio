<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="OpenWave.App.Views.InicioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:OpenWave.App.ViewModels"
    x:DataType="vm:InicioViewModel"
    Title="Inicio">

    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">

        <Label
            Grid.Row="0"
            Style="{StaticResource PageTitleLabel}"
            Text="Inicio" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Entry
                Grid.Column="0"
                Placeholder="Buscar emisora..."
                ReturnCommand="{Binding SearchCommand}"
                ReturnType="Search"
                Text="{Binding SearchText}" />
            <Button
                Grid.Column="1"
                Command="{Binding SearchCommand}"
                Text="Buscar" />
            <Button
                Grid.Column="2"
                Command="{Binding ClearSearchCommand}"
                Text="Limpiar" />
        </Grid>

        <!--  Saved Preferencias: shown when at least one is saved, applied or turned off for this session  -->
        <Border
            Grid.Row="2"
            IsVisible="{Binding ShowFilterBar}"
            Style="{StaticResource StationCard}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout
                    Grid.Column="0"
                    IsVisible="{Binding FiltersApplied}"
                    Spacing="2"
                    VerticalOptions="Center">
                    <Label Style="{StaticResource StationNameLabel}" Text="Filtros activos" />
                    <Label Style="{StaticResource SecondaryLabel}" Text="{Binding FilterSummary}" />
                </VerticalStackLayout>
                <Label
                    Grid.Column="0"
                    IsVisible="{Binding FiltersNotApplied}"
                    Style="{StaticResource StationNameLabel}"
                    Text="Preferencias desactivadas"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="1"
                    Command="{Binding DeactivateFiltersCommand}"
                    IsVisible="{Binding FiltersApplied}"
                    Text="Desactivar"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="1"
                    Command="{Binding ActivateFiltersCommand}"
                    IsVisible="{Binding FiltersNotApplied}"
                    Text="Activar"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">

            <CollectionView
                ItemsSource="{Binding Stations}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StationListItem">
                        <Border Margin="0,0,0,8" Style="{StaticResource StationCard}">
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsSelected}"
                                    TargetType="Border"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource SelectedItemBackgroundColor}" />
                                    <Setter Property="Stroke" Value="{DynamicResource AccentColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectStationCommand, Source={RelativeSource AncestorType={x:Type vm:InicioViewModel}}, x:DataType=vm:InicioViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label
                                        Style="{StaticResource StationNameLabel}"
                                        Text="{Binding Station.Name}" />
                                    <Label Style="{StaticResource SecondaryLabel}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="Station.Country" TargetNullValue="Desconocido" />
                                                <Binding Path="Station.Language" TargetNullValue="Desconocido" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <!--  A button consumes its own tap, so the heart never selects the station.  -->
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding ToggleFavoriteCommand, Source={RelativeSource AncestorType={x:Type vm:InicioViewModel}}, x:DataType=vm:InicioViewModel}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource FavoriteToggleButton}"
                                    Text="{Binding FavoriteGlyph}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding IsLoading}"
                Spacing="8"
                VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsLoading}" />
                <Label Style="{StaticResource SecondaryLabel}" Text="Cargando emisoras..." />
            </VerticalStackLayout>

            <Label
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding IsEmptyPlain}"
                Style="{StaticResource SecondaryLabel}"
                Text="No se encontraron emisoras."
                VerticalOptions="Center" />

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding IsEmptyWithPreferences}"
                Spacing="12"
                VerticalOptions="Center">
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SecondaryLabel}"
                    Text="No se encontraron emisoras con tus preferencias." />
                <Button
                    Command="{Binding DeactivateFiltersCommand}"
                    HorizontalOptions="Center"
                    Text="Desactivar" />
            </VerticalStackLayout>

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding HasError}"
                Spacing="12"
                VerticalOptions="Center">
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource ErrorLabel}"
                    Text="{Binding ErrorMessage}" />
                <Button
                    Command="{Binding RetryCommand}"
                    HorizontalOptions="Center"
                    Text="Reintentar" />
            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
