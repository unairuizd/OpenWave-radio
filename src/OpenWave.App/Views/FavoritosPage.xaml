<?xml version="1.0" encoding="UTF-8" ?>
<!--  The look comes from the active theme layout (FavoritosTemplate); the page keeps only its view model.  -->
<ContentPage
    x:Class="OpenWave.App.Views.FavoritosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:OpenWave.App.Services"
    xmlns:vm="clr-namespace:OpenWave.App.ViewModels"
    x:DataType="vm:FavoritosViewModel"
    Title="Favoritos"
    services:AppNavigation.Section="Favoritos"
    ControlTemplate="{DynamicResource FavoritosTemplate}"
    Shell.NavBarIsVisible="False" />
