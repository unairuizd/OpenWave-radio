<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Styles for the whole app. Every colour, font family and font size is read with DynamicResource:
    colours come from the active theme dictionary (Resources/Themes), and the font family and sizes
    below are defaults that the appearance settings replace at runtime. Pages only reference these
    styles, never literal colours, fonts or sizes.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Typography defaults (scale 1.0) -->
    <x:String x:Key="AppFontFamily">Ubuntu</x:String>
    <!-- Bold text: the font's bold file when it has one, otherwise the same (variable) font -->
    <x:String x:Key="AppFontFamilyBold">Ubuntu Bold</x:String>
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">16</x:Double>
    <x:Double x:Key="FontSizeSubtitle">18</x:Double>
    <x:Double x:Key="FontSizeTitle">24</x:Double>

    <!-- Layout sizes, not font sizes: they do not scale with the text -->
    <!-- Smallest width and height of every interactive control (48 dp on Android, 48 px on Windows) -->
    <x:Double x:Key="MinTouchTarget">48</x:Double>
    <x:Double x:Key="CardSpacing">12</x:Double>
    <x:Double x:Key="PlayerArtworkMaxSize">280</x:Double>

    <!-- Icon buttons: the icon is FontSizeTitle units wide plus 12 units of padding on each side, so it scales with
         the text. AppearanceService recomputes this value with the text size; it never goes below MinTouchTarget. -->
    <x:Double x:Key="IconButtonSize">48</x:Double>

    <!--
        Component size limits (phase 9). Text components: Normal values, which AppearanceService rewrites times the
        text-size factor (Services/ComponentSizes.cs). Drawn pieces: fixed limits and their width : height ratio, used
        with views:Controls/AspectBox; they never change with the text size.
    -->
    <x:Double x:Key="ChromeMinHeight">56</x:Double>
    <x:Double x:Key="ChromeMaxHeight">80</x:Double>
    <x:Double x:Key="StationCardMinWidth">150</x:Double>
    <x:Double x:Key="StationCardMaxWidth">220</x:Double>
    <x:Double x:Key="StationRowMinWidth">280</x:Double>
    <x:Double x:Key="StationRowMaxWidth">720</x:Double>
    <x:Double x:Key="StationRowMinHeight">48</x:Double>
    <x:Double x:Key="StationRowMaxHeight">96</x:Double>
    <x:Double x:Key="PlayerPanelMinWidth">280</x:Double>
    <x:Double x:Key="PlayerPanelMaxWidth">560</x:Double>
    <x:Double x:Key="SettingsColumnMinWidth">300</x:Double>
    <x:Double x:Key="SettingsColumnMaxWidth">720</x:Double>
    <x:Double x:Key="SettingsRowMinHeight">48</x:Double>
    <x:Double x:Key="SettingsRowMaxHeight">120</x:Double>
    <x:Double x:Key="FormMinWidth">280</x:Double>
    <x:Double x:Key="FormMaxWidth">480</x:Double>
    <x:Double x:Key="KeyMinWidth">48</x:Double>
    <x:Double x:Key="KeyMaxWidth">160</x:Double>
    <x:Double x:Key="KeyMinHeight">48</x:Double>
    <x:Double x:Key="KeyMaxHeight">72</x:Double>
    <x:Double x:Key="ListMaxHeight">560</x:Double>
    <x:Double x:Key="TurntableMinWidth">200</x:Double>
    <x:Double x:Key="TurntableMaxWidth">420</x:Double>
    <x:Double x:Key="TurntableRatio">1.15</x:Double>
    <x:Double x:Key="BigSleeveMinWidth">160</x:Double>
    <x:Double x:Key="BigSleeveMaxWidth">300</x:Double>
    <!-- The stack: the big sleeve and the two smaller ones below it (SleeveStack) -->
    <x:Double x:Key="BigSleeveRatio">0.69</x:Double>
    <x:Double x:Key="RecordCrateMinWidth">300</x:Double>
    <x:Double x:Key="RecordCrateMaxWidth">640</x:Double>
    <x:Double x:Key="RecordCrateRatio">2.4</x:Double>
    <x:Double x:Key="CassetteMinWidth">280</x:Double>
    <x:Double x:Key="CassetteMaxWidth">560</x:Double>
    <x:Double x:Key="CassetteRatio">1.6</x:Double>
    <x:Double x:Key="JCardMinWidth">300</x:Double>
    <x:Double x:Key="JCardMaxWidth">640</x:Double>
    <!-- The whole J-card: its title, the lines and the flip row -->
    <x:Double x:Key="JCardRatio">2</x:Double>
    <x:Double x:Key="TuningDialMinWidth">300</x:Double>
    <x:Double x:Key="TuningDialMaxWidth">640</x:Double>
    <x:Double x:Key="TuningDialRatio">3</x:Double>
    <x:Double x:Key="KnobMinWidth">56</x:Double>
    <x:Double x:Key="KnobMaxWidth">96</x:Double>
    <x:Double x:Key="KnobRatio">1</x:Double>
    <x:Double x:Key="SpeakerMinWidth">110</x:Double>
    <x:Double x:Key="SpeakerMaxWidth">220</x:Double>
    <x:Double x:Key="SpeakerRatio">1</x:Double>
    <x:Double x:Key="LevelMeterMinWidth">24</x:Double>
    <x:Double x:Key="LevelMeterMaxWidth">60</x:Double>
    <x:Double x:Key="LevelMeterRatio">0.25</x:Double>
    <x:Double x:Key="JogWheelMinWidth">200</x:Double>
    <x:Double x:Key="JogWheelMaxWidth">360</x:Double>
    <x:Double x:Key="JogWheelRatio">1</x:Double>
    <x:Double x:Key="PadsGridMinWidth">300</x:Double>
    <x:Double x:Key="PadsGridMaxWidth">640</x:Double>
    <x:Double x:Key="PadsGridRatio">2</x:Double>
    <!-- Boombox M1-M6: the same limits as the pads, three keys by two -->
    <x:Double x:Key="MemoryGridRatio">3</x:Double>
    <x:Double x:Key="LcdScreenMinWidth">300</x:Double>
    <x:Double x:Key="LcdScreenMaxWidth">640</x:Double>
    <x:Double x:Key="LcdScreenRatio">1.3333</x:Double>
    <x:Double x:Key="DeviceScreenMinWidth">300</x:Double>
    <x:Double x:Key="DeviceScreenMaxWidth">520</x:Double>
    <x:Double x:Key="DeviceScreenRatio">1.3333</x:Double>
    <x:Double x:Key="ClickWheelMinWidth">180</x:Double>
    <x:Double x:Key="ClickWheelMaxWidth">260</x:Double>
    <x:Double x:Key="ClickWheelRatio">1</x:Double>

    <!-- Implicit styles -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBackgroundColor}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource PageBackgroundColor}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource AccentColor}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource PrimaryTextColor}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource TabBarBackgroundColor}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource TabBarSelectedColor}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource TabBarSelectedColor}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource TabBarUnselectedColor}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource AccentTextColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource MinTouchTarget}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource SecondaryTextColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource InputBackgroundColor}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource SecondaryTextColor}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource AccentColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource InputBackgroundColor}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
        <Setter Property="TitleColor" Value="{DynamicResource SecondaryTextColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource InputBackgroundColor}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource AccentColor}" />
        <!-- Android otherwise draws a white background behind each option, which hides it in Negro. -->
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBackgroundColor}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource AccentColor}" />
    </Style>

    <!-- Named styles -->
    <Style x:Key="PageTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamilyBold}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
    </Style>

    <!-- Title in the Shell header (set as each page's TitleView by ShellChrome) -->
    <Style x:Key="HeaderTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamilyBold}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
        <Setter Property="Margin" Value="16,0" />
    </Style>

    <Style x:Key="SecondaryLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
    </Style>

    <Style x:Key="ErrorLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource ErrorTextColor}" />
    </Style>

    <Style x:Key="StationNameLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamilyBold}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
    </Style>

    <Style x:Key="StationCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayerArtwork" TargetType="Border">
        <Setter Property="WidthRequest" Value="{StaticResource PlayerArtworkMaxSize}" />
        <Setter Property="HeightRequest" Value="{StaticResource PlayerArtworkMaxSize}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon-only buttons (header gear, bottom bar, search row, card and player controls). The icon colour is set
         where the button is used, through IconTint.Color and a palette key. Transparent means "no background". -->
    <Style x:Key="IconButton" TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Aspect" Value="AspectFit" />
        <Setter Property="WidthRequest" Value="{DynamicResource IconButtonSize}" />
        <Setter Property="HeightRequest" Value="{DynamicResource IconButtonSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource MinTouchTarget}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource MinTouchTarget}" />
    </Style>

    <!-- Main action icon (play/stop): on the accent colour, round at the normal size; its icon uses AccentTextColor.
         The radius is half of MinTouchTarget: Android draws no background when it is more than half the size. -->
    <Style
        x:Key="AccentIconButton"
        BasedOn="{StaticResource IconButton}"
        TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
        <Setter Property="CornerRadius" Value="24" />
    </Style>

    <!--
        Shared settings pages (Ajustes, Personalización, Preferencias and the filter pages). They look the same in
        every theme: only these palette colours change.
    -->
    <Style x:Key="SettingsRow" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource SettingsRowMinHeight}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
        <Setter Property="MaximumHeightRequest" Value="{DynamicResource SettingsRowMaxHeight}" />
    </Style>

    <Style x:Key="SettingsRowTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamilyBold}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
    </Style>

    <Style x:Key="SettingsRowDescription" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="SettingsRowValue" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="SettingsChevron" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamilyBold}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Title of a group of settings ("Tema", "Dónde y en qué idioma"...) -->
    <Style x:Key="SettingsGroupLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamilyBold}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <!-- Invisible button over a whole row or card: the keyboard and screen readers reach the row through it -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Text" Value="" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource MinTouchTarget}" />
    </Style>

    <!-- Choice chips (fonts, content types) and segments. Pages set the selected look with colour triggers. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource KeyMinHeight}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>
        <Setter Property="MaximumHeightRequest" Value="{DynamicResource KeyMaxHeight}" />
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource KeyMinWidth}" />
        <Setter Property="MaximumWidthRequest" Value="{DynamicResource SettingsColumnMaxWidth}" />
    </Style>

    <Style x:Key="ChipLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Text buttons of the settings pages: the main action on the accent colour, the others outlined -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamilyBold}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource AccentTextColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,10" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource KeyMinHeight}" />
        <!-- A long label wraps instead of being cut (small window at a large text size) -->
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{DynamicResource DividerColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,10" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource KeyMinHeight}" />
        <!-- A long label wraps instead of being cut (small window at a large text size) -->
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <!-- Large full-width text button; Clásico de rueda builds its menu-row buttons on it -->
    <Style x:Key="SettingsCardButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamilyBold}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource DividerColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,20" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource MinTouchTarget}" />
    </Style>

</ResourceDictionary>
