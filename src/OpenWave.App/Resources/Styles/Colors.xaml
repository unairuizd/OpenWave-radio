<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Semantic palette. Pages and styles must reference these keys, never raw colours. -->
    <Color x:Key="PageBackgroundColor">#F5F5F8</Color>
    <Color x:Key="PageBackgroundColorDark">#121216</Color>

    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColorDark">#1E1E24</Color>

    <Color x:Key="PrimaryTextColor">#1B1B1F</Color>
    <Color x:Key="PrimaryTextColorDark">#F2F2F5</Color>

    <Color x:Key="SecondaryTextColor">#5F5F6B</Color>
    <Color x:Key="SecondaryTextColorDark">#B4B4BF</Color>

    <Color x:Key="AccentColor">#3A5BD9</Color>
    <Color x:Key="AccentColorDark">#8FA6FF</Color>

    <Color x:Key="OnAccentTextColor">#FFFFFF</Color>
    <Color x:Key="OnAccentTextColorDark">#101014</Color>

    <Color x:Key="ErrorColor">#B3261E</Color>
    <Color x:Key="ErrorColorDark">#FFB4AB</Color>

    <Color x:Key="DividerColor">#DADAE2</Color>
    <Color x:Key="DividerColorDark">#34343D</Color>

    <Color x:Key="SelectedSurfaceColor">#E4E9FB</Color>
    <Color x:Key="SelectedSurfaceColorDark">#252D4A</Color>

</ResourceDictionary>
