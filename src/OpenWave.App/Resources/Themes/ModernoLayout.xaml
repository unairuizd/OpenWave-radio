<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Moderno layout: the page templates, the header and the station card.
    Colours come from the active palette and fonts and sizes from Styles.xaml, always through
    DynamicResource or the named styles: a layout never sets a colour, font family or font size itself.

    Keys every layout defines: HeaderTemplate, StationCardTemplate, InicioTemplate, ReproductorTemplate and
    FavoritosTemplate. The bottom bar (views:BottomBar) and the settings pages are shared by every theme.
-->
<ResourceDictionary
    x:Class="OpenWave.App.Resources.Themes.ModernoLayout"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:OpenWave.App.Services.Localization"
    xmlns:behaviors="clr-namespace:OpenWave.App.Behaviors"
    xmlns:controls="clr-namespace:OpenWave.App.Views.Controls"
    xmlns:services="clr-namespace:OpenWave.App.Services"
    xmlns:views="clr-namespace:OpenWave.App.Views"
    xmlns:vm="clr-namespace:OpenWave.App.ViewModels">

    <!--
        Header: the page title in upper case, centred on the full width, and the gear on the right. The empty
        column on the left is as wide as the gear, so the title stays centred on the page. The title uses the
        subtitle size and wraps rather than being cut, so even "PERSONALIZACIÓN" fits a phone at Enorme.
    -->
    <ControlTemplate x:Key="HeaderTemplate">
        <Grid
            MinimumHeightRequest="{DynamicResource ChromeMinHeight}"
            MaximumHeightRequest="{DynamicResource ChromeMaxHeight}"
            BackgroundColor="{DynamicResource PageBackgroundColor}"
            ColumnDefinitions="Auto,*,Auto"
            RowDefinitions="Auto,Auto">
            <BoxView
                Grid.Column="0"
                Color="Transparent"
                WidthRequest="{DynamicResource IconButtonSize}" />
            <Label
                Grid.Column="1"
                Margin="0"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                SemanticProperties.HeadingLevel="Level1"
                Style="{StaticResource HeaderTitleLabel}"
                Text="{Binding Title, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=ContentPage}"
                TextTransform="Uppercase"
                VerticalOptions="Center" />
            <ImageButton
                Grid.Column="2"
                Margin="0,4,4,4"
                behaviors:IconTint.Color="{DynamicResource PrimaryTextColor}"
                Command="{x:Static services:AppNavigation.OpenAjustesCommand}"
                SemanticProperties.Description="{loc:Translate Nav_Ajustes}"
                Source="ic_settings.png"
                Style="{StaticResource IconButton}"
                ToolTipProperties.Text="{loc:Translate Nav_Ajustes}" />
            <BoxView
                Grid.Row="1"
                Grid.ColumnSpan="3"
                HeightRequest="1"
                Color="{DynamicResource DividerColor}" />
        </Grid>
    </ControlTemplate>

    <!--
        Station card for Inicio and Favoritos (portrait): square logo, name, details, then play and heart.
        The two invisible two-line labels reserve two lines for the name and the details, so every card has the
        same height (the Windows grid sizes all items like the first one it measures).
    -->
    <DataTemplate x:Key="StationCardTemplate" x:DataType="vm:StationListItem">
        <Border
            Padding="10"
            HorizontalOptions="Center"
            MaximumWidthRequest="{DynamicResource StationCardMaxWidth}"
            SemanticProperties.Description="{Binding Station.Name}"
            Style="{StaticResource StationCard}">
            <Border.Triggers>
                <DataTrigger
                    Binding="{Binding IsSelected}"
                    TargetType="Border"
                    Value="True">
                    <Setter Property="BackgroundColor" Value="{DynamicResource SelectedItemBackgroundColor}" />
                    <Setter Property="Stroke" Value="{DynamicResource AccentColor}" />
                    <Setter Property="StrokeThickness" Value="2" />
                </DataTrigger>
            </Border.Triggers>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding PlayCommand}" CommandParameter="{Binding .}" />
            </Border.GestureRecognizers>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                <Grid Grid.Row="0" HeightRequest="{Binding Width, Source={RelativeSource Self}, x:DataType=Grid}">
                    <Image Aspect="AspectFit" Source="station_placeholder.png" />
                    <Image Aspect="AspectFit" Source="{Binding Station.LogoUrl}" />
                </Grid>
                <Grid Grid.Row="1">
                    <Label
                        AutomationProperties.IsInAccessibleTree="False"
                        MaxLines="2"
                        Opacity="0"
                        Style="{StaticResource StationNameLabel}"
                        Text="X&#10;X" />
                    <Label
                        LineBreakMode="TailTruncation"
                        MaxLines="2"
                        Style="{StaticResource StationNameLabel}"
                        Text="{Binding Station.Name}" />
                </Grid>
                <Grid Grid.Row="2">
                    <Label
                        AutomationProperties.IsInAccessibleTree="False"
                        MaxLines="2"
                        Opacity="0"
                        Style="{StaticResource SecondaryLabel}"
                        Text="X&#10;X" />
                    <Label
                        LineBreakMode="TailTruncation"
                        MaxLines="2"
                        Style="{StaticResource SecondaryLabel}"
                        Text="{Binding Details}" />
                </Grid>
                <!--  Buttons consume their own tap, so the heart never selects the station.  -->
                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
                    <ImageButton
                        Grid.Column="0"
                        behaviors:IconTint.Color="{DynamicResource AccentTextColor}"
                        Command="{Binding PlayCommand}"
                        CommandParameter="{Binding .}"
                        SemanticProperties.Description="{Binding PlayDescription}"
                        Source="ic_play.png"
                        Style="{StaticResource AccentIconButton}" />
                    <ImageButton
                        Grid.Column="2"
                        behaviors:IconTint.Color="{DynamicResource FavoriteIconColor}"
                        Command="{Binding HeartCommand}"
                        CommandParameter="{Binding .}"
                        Style="{StaticResource IconButton}">
                        <ImageButton.Triggers>
                            <DataTrigger
                                Binding="{Binding IsFavorite}"
                                TargetType="ImageButton"
                                Value="False">
                                <Setter Property="Source" Value="ic_heart_outline.png" />
                                <Setter Property="SemanticProperties.Description" Value="{loc:Translate Action_AddFavorite}" />
                            </DataTrigger>
                            <DataTrigger
                                Binding="{Binding IsFavorite}"
                                TargetType="ImageButton"
                                Value="True">
                                <Setter Property="Source" Value="ic_heart.png" />
                                <Setter Property="SemanticProperties.Description" Value="{loc:Translate Action_RemoveFavorite}" />
                            </DataTrigger>
                        </ImageButton.Triggers>
                    </ImageButton>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <!--
        Page templates. Templated content does not inherit the page's view model, so each root takes the page's
        BindingContext. Rows: header, content (the only part that scrolls), bottom bar.
    -->
    <ControlTemplate x:Key="InicioTemplate">
        <Grid
            x:DataType="vm:InicioViewModel"
            BackgroundColor="{DynamicResource PageBackgroundColor}"
            BindingContext="{Binding BindingContext, Source={RelativeSource TemplatedParent}, x:DataType=ContentPage}"
            RowDefinitions="Auto,*,Auto">
            <ContentView Grid.Row="0" ControlTemplate="{StaticResource HeaderTemplate}" />

            <Grid
                Grid.Row="1"
                Padding="16,12,16,0"
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="12">

                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="4">
                    <Entry
                        Grid.Column="0"
                        Placeholder="{loc:Translate Search_StationPlaceholder}"
                        ReturnCommand="{Binding SearchCommand}"
                        ReturnType="Search"
                        SemanticProperties.Description="{loc:Translate Search_Station}"
                        Text="{Binding SearchText}"
                        VerticalOptions="Center" />
                    <ImageButton
                        Grid.Column="1"
                        behaviors:IconTint.Color="{DynamicResource PrimaryTextColor}"
                        Command="{Binding SearchCommand}"
                        SemanticProperties.Description="{loc:Translate Action_Search}"
                        Source="ic_search.png"
                        Style="{StaticResource IconButton}"
                        ToolTipProperties.Text="{loc:Translate Action_Search}" />
                    <ImageButton
                        Grid.Column="2"
                        behaviors:IconTint.Color="{DynamicResource PrimaryTextColor}"
                        Command="{Binding ClearSearchCommand}"
                        SemanticProperties.Description="{loc:Translate Search_Clear}"
                        Source="ic_clear.png"
                        Style="{StaticResource IconButton}"
                        ToolTipProperties.Text="{loc:Translate Search_Clear}" />
                </Grid>

                <!--  Saved Preferencias: shown when at least one is saved, applied or turned off for this session  -->
                <Border
                    Grid.Row="1"
                    IsVisible="{Binding ShowFilterBar}"
                    Style="{StaticResource StationCard}">
                    <FlexLayout AlignItems="Center" JustifyContent="SpaceBetween" Wrap="Wrap">
                        <VerticalStackLayout
                            FlexLayout.Grow="1"
                            IsVisible="{Binding FiltersApplied}"
                            Spacing="2"
                            VerticalOptions="Center">
                            <Label Style="{StaticResource StationNameLabel}" Text="{loc:Translate Inicio_FiltersOn}" />
                            <Label Style="{StaticResource SecondaryLabel}" Text="{Binding FilterSummary}" />
                        </VerticalStackLayout>
                        <Label
                            FlexLayout.Grow="1"
                            IsVisible="{Binding FiltersNotApplied}"
                            Style="{StaticResource StationNameLabel}"
                            Text="{loc:Translate Inicio_FiltersOff}"
                            VerticalOptions="Center" />
                        <Button
                            Command="{Binding DeactivateFiltersCommand}"
                            IsVisible="{Binding FiltersApplied}"
                            Text="{loc:Translate Action_Disable}"
                            VerticalOptions="Center" />
                        <Button
                            Command="{Binding ActivateFiltersCommand}"
                            IsVisible="{Binding FiltersNotApplied}"
                            Text="{loc:Translate Action_Enable}"
                            VerticalOptions="Center" />
                    </FlexLayout>
                </Border>

                <!--  Dato del día: the same shared strip in every theme (Views/FunFactStrip)  -->
                <views:FunFactStrip Grid.Row="2" />

                <Grid Grid.Row="3">
                    <CollectionView
                        ItemTemplate="{StaticResource StationCardTemplate}"
                        ItemsSource="{Binding Stations}"
                        SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                HorizontalItemSpacing="{StaticResource CardSpacing}"
                                Orientation="Vertical"
                                Span="2"
                                VerticalItemSpacing="{StaticResource CardSpacing}" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Behaviors>
                            <behaviors:AdaptiveSpanBehavior />
                        </CollectionView.Behaviors>
                    </CollectionView>

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        IsVisible="{Binding IsLoading}"
                        Spacing="8"
                        VerticalOptions="Center">
                        <ActivityIndicator IsRunning="{Binding IsLoading}" />
                        <Label Style="{StaticResource SecondaryLabel}" Text="{loc:Translate Inicio_Loading}" />
                    </VerticalStackLayout>

                    <Label
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding IsEmptyPlain}"
                        Style="{StaticResource SecondaryLabel}"
                        Text="{loc:Translate Inicio_NoStations}"
                        VerticalOptions="Center" />

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        IsVisible="{Binding IsEmptyWithPreferences}"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource SecondaryLabel}"
                            Text="{loc:Translate Inicio_NoStationsFiltered}" />
                        <Button
                            Command="{Binding DeactivateFiltersCommand}"
                            HorizontalOptions="Center"
                            Text="{loc:Translate Action_Disable}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        IsVisible="{Binding HasError}"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource ErrorLabel}"
                            Text="{Binding ErrorMessage}" />
                        <Button
                            Command="{Binding RetryCommand}"
                            HorizontalOptions="Center"
                            Text="{loc:Translate Action_Retry}" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <views:BottomBar Grid.Row="2" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="FavoritosTemplate">
        <Grid
            x:DataType="vm:FavoritosViewModel"
            BackgroundColor="{DynamicResource PageBackgroundColor}"
            BindingContext="{Binding BindingContext, Source={RelativeSource TemplatedParent}, x:DataType=ContentPage}"
            RowDefinitions="Auto,*,Auto">
            <ContentView Grid.Row="0" ControlTemplate="{StaticResource HeaderTemplate}" />

            <Grid
                Grid.Row="1"
                Padding="16,8,16,0"
                RowDefinitions="Auto,*"
                RowSpacing="8">

                <!--  Logged in: compact account row directly under the header  -->
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8"
                    IsVisible="{Binding IsLoggedIn}">
                    <Label
                        Grid.Column="0"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Style="{StaticResource SecondaryLabel}"
                        Text="{Binding Email}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Padding="12,4"
                        Command="{Binding LogOutCommand}"
                        Text="{loc:Translate Session_LogOut}" />
                </Grid>

                <!--  Logged out  -->
                <VerticalStackLayout
                    Grid.Row="0"
                    Padding="0,8,0,0"
                    IsVisible="{Binding IsLoggedOut}"
                    Spacing="12">
                    <Label Text="{loc:Translate Favoritos_LogInHintSentence}" />
                    <Button
                        Command="{Binding LogInCommand}"
                        HorizontalOptions="Start"
                        Text="{loc:Translate Page_Login}" />
                </VerticalStackLayout>

                <!--  Logged in: list and its states  -->
                <Grid Grid.Row="1" IsVisible="{Binding IsLoggedIn}">
                    <CollectionView
                        ItemTemplate="{StaticResource StationCardTemplate}"
                        ItemsSource="{Binding Stations}"
                        SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                                HorizontalItemSpacing="{StaticResource CardSpacing}"
                                Orientation="Vertical"
                                Span="2"
                                VerticalItemSpacing="{StaticResource CardSpacing}" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Behaviors>
                            <behaviors:AdaptiveSpanBehavior />
                        </CollectionView.Behaviors>
                    </CollectionView>

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        IsVisible="{Binding IsLoading}"
                        Spacing="8"
                        VerticalOptions="Center">
                        <ActivityIndicator IsRunning="{Binding IsLoading}" />
                        <Label Style="{StaticResource SecondaryLabel}" Text="{loc:Translate Favoritos_Loading}" />
                    </VerticalStackLayout>

                    <Label
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding IsEmpty}"
                        Style="{StaticResource SecondaryLabel}"
                        Text="{loc:Translate Favoritos_Empty}"
                        VerticalOptions="Center" />

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        IsVisible="{Binding HasError}"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource ErrorLabel}"
                            Text="{Binding ErrorMessage}" />
                        <Button
                            Command="{Binding RetryCommand}"
                            HorizontalOptions="Center"
                            Text="{loc:Translate Action_Retry}" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <views:BottomBar Grid.Row="2" />
        </Grid>
    </ControlTemplate>

    <!--
        Reproductor. The app's single audio player belongs to the window, not to this page or layout; the 1x1
        ContentPresenter only presents the page's (empty) content.
    -->
    <ControlTemplate x:Key="ReproductorTemplate">
        <Grid
            x:DataType="vm:ReproductorViewModel"
            BackgroundColor="{DynamicResource PageBackgroundColor}"
            BindingContext="{Binding BindingContext, Source={RelativeSource TemplatedParent}, x:DataType=ContentPage}"
            RowDefinitions="Auto,*,Auto">
            <ContentView Grid.Row="0" ControlTemplate="{StaticResource HeaderTemplate}" />

            <ContentPresenter
                Grid.Row="1"
                HeightRequest="1"
                HorizontalOptions="Start"
                InputTransparent="True"
                VerticalOptions="Start"
                WidthRequest="1" />

            <ScrollView Grid.Row="1">
                <controls:SizeLimit MinWidth="{DynamicResource PlayerPanelMinWidth}" MaxWidth="{DynamicResource PlayerPanelMaxWidth}">
                    <VerticalStackLayout Padding="16" Spacing="16">

                        <!--  No station yet: the message replaces the logo and the station info  -->
                        <Label
                            Margin="0,24"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            IsVisible="{Binding HasNoStation}"
                            Style="{StaticResource SecondaryLabel}"
                            Text="{loc:Translate Reproductor_ChooseShort}" />

                        <Border
                            HorizontalOptions="Center"
                            IsVisible="{Binding HasStation}"
                            Style="{StaticResource PlayerArtwork}">
                            <Grid>
                                <Image Aspect="AspectFit" Source="station_placeholder.png" />
                                <Image Aspect="AspectFit" Source="{Binding LogoUrl}" />
                            </Grid>
                        </Border>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8"
                            IsVisible="{Binding HasStation}">
                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="4"
                                VerticalOptions="Center">
                                <Label Style="{StaticResource PageTitleLabel}" Text="{Binding StationName}" />
                                <Label
                                    IsVisible="{Binding HasDetails}"
                                    Style="{StaticResource SecondaryLabel}"
                                    Text="{Binding Details}" />
                            </VerticalStackLayout>
                            <ImageButton
                                Grid.Column="1"
                                behaviors:IconTint.Color="{DynamicResource FavoriteIconColor}"
                                Command="{Binding ToggleFavoriteCommand}"
                                Style="{StaticResource IconButton}"
                                VerticalOptions="Center">
                                <ImageButton.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsFavorite}"
                                        TargetType="ImageButton"
                                        Value="False">
                                        <Setter Property="Source" Value="ic_heart_outline.png" />
                                        <Setter Property="SemanticProperties.Description" Value="{loc:Translate Action_AddFavorite}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsFavorite}"
                                        TargetType="ImageButton"
                                        Value="True">
                                        <Setter Property="Source" Value="ic_heart.png" />
                                        <Setter Property="SemanticProperties.Description" Value="{loc:Translate Action_RemoveFavorite}" />
                                    </DataTrigger>
                                </ImageButton.Triggers>
                            </ImageButton>
                        </Grid>

                        <!--  Previous favourite, play/stop, next favourite  -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="24">
                            <ImageButton
                                behaviors:IconTint.Color="{DynamicResource PrimaryTextColor}"
                                Command="{Binding PreviousFavoriteCommand}"
                                SemanticProperties.Description="{loc:Translate Favoritos_PreviousStation}"
                                Source="ic_previous.png"
                                Style="{StaticResource IconButton}"
                                ToolTipProperties.Text="{loc:Translate Favoritos_Previous}"
                                VerticalOptions="Center" />
                            <ImageButton
                                behaviors:IconTint.Color="{DynamicResource AccentTextColor}"
                                Command="{Binding ToggleCommand}"
                                IsEnabled="{Binding HasStation}"
                                Style="{StaticResource AccentIconButton}"
                                VerticalOptions="Center">
                                <ImageButton.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsActive}"
                                        TargetType="ImageButton"
                                        Value="False">
                                        <Setter Property="Source" Value="ic_play.png" />
                                        <Setter Property="SemanticProperties.Description" Value="{loc:Translate Action_Play}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsActive}"
                                        TargetType="ImageButton"
                                        Value="True">
                                        <Setter Property="Source" Value="ic_stop.png" />
                                        <Setter Property="SemanticProperties.Description" Value="{loc:Translate Action_Stop}" />
                                    </DataTrigger>
                                    <Trigger
                                        Property="IsEnabled"
                                        TargetType="ImageButton"
                                        Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ImageButton.Triggers>
                            </ImageButton>
                            <ImageButton
                                behaviors:IconTint.Color="{DynamicResource PrimaryTextColor}"
                                Command="{Binding NextFavoriteCommand}"
                                SemanticProperties.Description="{loc:Translate Favoritos_NextStation}"
                                Source="ic_next.png"
                                Style="{StaticResource IconButton}"
                                ToolTipProperties.Text="{loc:Translate Favoritos_Next}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!--  Status line  -->
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding HasStation}"
                                Style="{StaticResource StationNameLabel}"
                                Text="{Binding StatusText}" />
                            <Label
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding HasNotice}"
                                Style="{StaticResource SecondaryLabel}"
                                Text="{Binding Notice}" />
                            <Label
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding HasError}"
                                Style="{StaticResource ErrorLabel}"
                                Text="{Binding ErrorMessage}" />
                            <Button
                                Command="{Binding RetryCommand}"
                                HorizontalOptions="Center"
                                IsVisible="{Binding HasError}"
                                Text="{loc:Translate Action_Retry}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </controls:SizeLimit>
            </ScrollView>

            <views:BottomBar Grid.Row="2" />
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
