<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Tocadiscos "standard" palette: walnut wood, cream sleeves, brass and vinyl black. Defines exactly the same colour
    keys as ModernoLightPalette.xaml. Text is light and always sits on wood or on brass; the cream (TabBarUnselectedColor)
    carries only logos and the dark AccentTextColor.
-->
<ResourceDictionary
    x:Class="OpenWave.App.Resources.Themes.TocadiscosPalette"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Pages and surfaces: walnut page, lighter wood panels, vinyl black for records and inputs -->
    <Color x:Key="PageBackgroundColor">#3A2416</Color>
    <Color x:Key="SurfaceColor">#4E3322</Color>
    <Color x:Key="InputBackgroundColor">#15100C</Color>
    <Color x:Key="DividerColor">#6E4E33</Color>
    <Color x:Key="SelectedItemBackgroundColor">#E3AE4F</Color>

    <!-- Text: warm light -->
    <Color x:Key="PrimaryTextColor">#F6EBD6</Color>
    <Color x:Key="SecondaryTextColor">#D9C6A5</Color>
    <Color x:Key="ErrorTextColor">#FFA48C</Color>

    <!-- Accent: brass -->
    <Color x:Key="AccentColor">#D9A441</Color>
    <Color x:Key="AccentTextColor">#24160B</Color>
    <Color x:Key="FavoriteIconColor">#F0BC62</Color>

    <!-- Bottom bar: dark wood strip; the unselected colour is also the cream of sleeves and cards -->
    <Color x:Key="TabBarBackgroundColor">#25170D</Color>
    <Color x:Key="TabBarSelectedColor">#F2C46D</Color>
    <Color x:Key="TabBarUnselectedColor">#EADBBE</Color>

</ResourceDictionary>
