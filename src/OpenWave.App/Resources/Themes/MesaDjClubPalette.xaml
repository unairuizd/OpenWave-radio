<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Mesa de DJ "Club" palette: a near-black controller body, dark screen panels, light text, a cyan accent and orange
    hearts and current pad. The selected-item colour is the dark teal background of the current browser row. Same
    colour keys as every palette.
-->
<ResourceDictionary
    x:Class="OpenWave.App.Resources.Themes.MesaDjClubPalette"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Pages and surfaces -->
    <Color x:Key="PageBackgroundColor">#0D0F12</Color>
    <Color x:Key="SurfaceColor">#1A1E24</Color>
    <Color x:Key="InputBackgroundColor">#050608</Color>
    <Color x:Key="DividerColor">#2E343D</Color>
    <Color x:Key="SelectedItemBackgroundColor">#12343A</Color>

    <!-- Text -->
    <Color x:Key="PrimaryTextColor">#EEF2F6</Color>
    <Color x:Key="SecondaryTextColor">#A7B0BC</Color>
    <Color x:Key="ErrorTextColor">#FF7A7A</Color>

    <!-- Accent: cyan keys, jog ring and lit pads; orange hearts and current pad -->
    <Color x:Key="AccentColor">#00D1E0</Color>
    <Color x:Key="AccentTextColor">#00191C</Color>
    <Color x:Key="FavoriteIconColor">#FF8A2B</Color>

    <!-- Bottom strip -->
    <Color x:Key="TabBarBackgroundColor">#08090B</Color>
    <Color x:Key="TabBarSelectedColor">#00D1E0</Color>
    <Color x:Key="TabBarUnselectedColor">#8D96A3</Color>

</ResourceDictionary>
