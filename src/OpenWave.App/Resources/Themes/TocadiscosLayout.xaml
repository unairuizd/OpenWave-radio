<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Tocadiscos layout: a 1960s-70s record player. Stations are record sleeves, the player is a turntable and the
    favourites live in a record crate. Colours come from the active palette and fonts and sizes from Styles.xaml,
    always through DynamicResource or the named styles: this layout never sets a colour, font family or font size itself.
    It defines every key itself and does not use the Moderno layout.

    Keys every layout defines: HeaderTemplate, StationCardTemplate, InicioTemplate, ReproductorTemplate and
    FavoritosTemplate. The bottom bar (views:BottomBar) and the settings pages are shared by every theme. Tocadiscos adds ReproductorHeaderTemplate and CrateRecordTemplate.
-->
<ResourceDictionary
    x:Class="OpenWave.App.Resources.Themes.TocadiscosLayout"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:OpenWave.App.Services.Localization"
    xmlns:behaviors="clr-namespace:OpenWave.App.Behaviors"
    xmlns:controls="clr-namespace:OpenWave.App.Views.Controls"
    xmlns:services="clr-namespace:OpenWave.App.Services"
    xmlns:views="clr-namespace:OpenWave.App.Views"
    xmlns:vm="clr-namespace:OpenWave.App.ViewModels">

    <!--  Styles of this layout (colours from palette keys only; fonts and sizes from the shared styles)  -->
    <Style
        x:Key="TocadiscosTitleLabel"
        BasedOn="{StaticResource HeaderTitleLabel}"
        TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TabBarSelectedColor}" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="TocadiscosPanel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Header: a dark wooden strip with the title in brass, upper case, centred on the full width, and the gear on the
        right. The empty column on the left is as wide as the gear, so the title stays centred.
    -->
    <ControlTemplate x:Key="HeaderTemplate">
        <Grid
            MinimumHeightRequest="{DynamicResource ChromeMinHeight}"
            MaximumHeightRequest="{DynamicResource ChromeMaxHeight}"
            BackgroundColor="{DynamicResource TabBarBackgroundColor}"
            ColumnDefinitions="Auto,*,Auto"
            RowDefinitions="Auto,Auto">
            <BoxView
                Grid.Column="0"
                WidthRequest="{DynamicResource IconButtonSize}"
                Color="Transparent" />
            <Label
                Grid.Column="1"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                SemanticProperties.HeadingLevel="Level1"
                Style="{StaticResource TocadiscosTitleLabel}"
                Text="{Binding Title, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=ContentPage}"
                TextTransform="Uppercase"
                VerticalOptions="Center" />
            <ImageButton
                Grid.Column="2"
                Margin="0,4,4,4"
                behaviors:IconTint.Color="{DynamicResource TabBarSelectedColor}"
                Command="{x:Static services:AppNavigation.OpenAjustesCommand}"
                SemanticProperties.Description="{loc:Translate Nav_Ajustes}"
                Source="ic_settings.png"
                Style="{StaticResource IconButton}"
                ToolTipProperties.Text="{loc:Translate Nav_Ajustes}" />
            <BoxView
                Grid.Row="1"
                Grid.ColumnSpan="3"
                HeightRequest="3"
                Color="{DynamicResource AccentColor}" />
        </Grid>
    </ControlTemplate>

    <!--  Reproductor's header: the same, with a house on the left that opens Inicio (this page has no bottom bar)  -->
    <ControlTemplate x:Key="ReproductorHeaderTemplate">
        <Grid
            MinimumHeightRequest="{DynamicResource ChromeMinHeight}"
            BackgroundColor="{DynamicResource TabBarBackgroundColor}"
            ColumnDefinitions="Auto,*,Auto"
            RowDefinitions="Auto,Auto">
            <ImageButton
                Grid.Column="0"
                Margin="4,4,0,4"
                behaviors:IconTint.Color="{DynamicResource TabBarSelectedColor}"
                Command="{x:Static services:AppNavigation.GoToSectionCommand}"
                CommandParameter="inicio"
                SemanticProperties.Description="{loc:Translate Nav_Inicio}"
                Source="ic_home.png"
                Style="{StaticResource IconButton}"
                ToolTipProperties.Text="{loc:Translate Nav_Inicio}" />
            <Label
                Grid.Column="1"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                SemanticProperties.HeadingLevel="Level1"
                Style="{StaticResource TocadiscosTitleLabel}"
                Text="{Binding Title, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=ContentPage}"
                TextTransform="Uppercase"
                VerticalOptions="Center" />
            <ImageButton
                Grid.Column="2"
                Margin="0,4,4,4"
                behaviors:IconTint.Color="{DynamicResource TabBarSelectedColor}"
                Command="{x:Static services:AppNavigation.OpenAjustesCommand}"
                SemanticProperties.Description="{loc:Translate Nav_Ajustes}"
                Source="ic_settings.png"
                Style="{StaticResource IconButton}"
                ToolTipProperties.Text="{loc:Translate Nav_Ajustes}" />
            <BoxView
                Grid.Row="1"
                Grid.ColumnSpan="3"
                HeightRequest="3"
                Color="{DynamicResource AccentColor}" />
        </Grid>
    </ControlTemplate>

    <!--
        A record sleeve (the station item of Inicio and Favoritos): a square cream sleeve with the logo. The current
        station's sleeve has a brass outline and its record peeks out of the right edge.
    -->
    <DataTemplate x:Key="StationCardTemplate" x:DataType="vm:StationListItem">
        <AbsoluteLayout>
            <Grid
                AbsoluteLayout.LayoutBounds="1,0.5,0.74,0.74"
                AbsoluteLayout.LayoutFlags="All"
                IsVisible="{Binding IsSelected}">
                <Ellipse Fill="{DynamicResource InputBackgroundColor}" />
                <Ellipse
                    Scale="0.8"
                    Stroke="{DynamicResource DividerColor}"
                    StrokeThickness="1" />
                <Ellipse
                    Scale="0.6"
                    Stroke="{DynamicResource DividerColor}"
                    StrokeThickness="1" />
                <Ellipse Fill="{DynamicResource AccentColor}" Scale="0.3" />
            </Grid>
            <Border
                Padding="0"
                AbsoluteLayout.LayoutBounds="0,0.5,0.82,0.82"
                AbsoluteLayout.LayoutFlags="All"
                BackgroundColor="{DynamicResource TabBarUnselectedColor}"
                Stroke="{DynamicResource DividerColor}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="3" />
                </Border.StrokeShape>
                <Border.Triggers>
                    <DataTrigger
                        Binding="{Binding IsSelected}"
                        TargetType="Border"
                        Value="True">
                        <Setter Property="Stroke" Value="{DynamicResource SelectedItemBackgroundColor}" />
                        <Setter Property="StrokeThickness" Value="5" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid Margin="10">
                    <Image Aspect="AspectFit" Source="station_placeholder.png" />
                    <Image Aspect="AspectFit" Source="{Binding Station.LogoUrl}" />
                </Grid>
            </Border>
        </AbsoluteLayout>
    </DataTemplate>

    <!--  A record standing in the crate: its sleeve with the logo, the disc peeking out above, and the name  -->
    <DataTemplate x:Key="CrateRecordTemplate" x:DataType="vm:StationListItem">
        <Grid RowDefinitions="*,Auto" RowSpacing="2">
            <Grid.Triggers>
                <DataTrigger
                    Binding="{Binding IsSelected}"
                    TargetType="Grid"
                    Value="True">
                    <Setter Property="TranslationY" Value="-12" />
                </DataTrigger>
            </Grid.Triggers>
            <AbsoluteLayout Grid.Row="0">
                <Ellipse
                    AbsoluteLayout.LayoutBounds="0.5,0,0.8,0.5"
                    AbsoluteLayout.LayoutFlags="All"
                    Fill="{DynamicResource InputBackgroundColor}"
                    Stroke="{DynamicResource DividerColor}"
                    StrokeThickness="1" />
                <Border
                    Padding="4"
                    AbsoluteLayout.LayoutBounds="0.5,1,1,0.82"
                    AbsoluteLayout.LayoutFlags="All"
                    BackgroundColor="{DynamicResource TabBarUnselectedColor}"
                    Stroke="{DynamicResource DividerColor}"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="2" />
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger
                            Binding="{Binding IsSelected}"
                            TargetType="Border"
                            Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource SelectedItemBackgroundColor}" />
                            <Setter Property="StrokeThickness" Value="3" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Grid>
                        <Image Aspect="AspectFit" Source="station_placeholder.png" />
                        <Image Aspect="AspectFit" Source="{Binding Station.LogoUrl}" />
                    </Grid>
                </Border>
            </AbsoluteLayout>
            <Label
                Grid.Row="1"
                HorizontalTextAlignment="Center"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                Style="{StaticResource SecondaryLabel}"
                Text="{Binding Station.Name}" />
        </Grid>
    </DataTemplate>

    <!--
        Page templates. Templated content does not inherit the page's view model, so each root takes the page's
        BindingContext. Only the main area scrolls; the header and the bar stay fixed.
    -->
    <ControlTemplate x:Key="InicioTemplate">
        <Grid
            x:DataType="vm:InicioViewModel"
            BackgroundColor="{DynamicResource PageBackgroundColor}"
            BindingContext="{Binding BindingContext, Source={RelativeSource TemplatedParent}, x:DataType=ContentPage}"
            RowDefinitions="Auto,Auto,Auto,*,Auto">
            <ContentView Grid.Row="0" ControlTemplate="{StaticResource HeaderTemplate}" />

            <!--  Search row  -->
            <Grid
                Grid.Row="1"
                Padding="16,10,16,0"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="4">
                <Entry
                    Grid.Column="0"
                    Placeholder="{loc:Translate Search_StationPlaceholder}"
                    ReturnCommand="{Binding SearchCommand}"
                    ReturnType="Search"
                    SemanticProperties.Description="{loc:Translate Search_Station}"
                    Text="{Binding SearchText}"
                    VerticalOptions="Center" />
                <ImageButton
                    Grid.Column="1"
                    behaviors:IconTint.Color="{DynamicResource TabBarSelectedColor}"
                    Command="{Binding SearchCommand}"
                    SemanticProperties.Description="{loc:Translate Action_Search}"
                    Source="ic_search.png"
                    Style="{StaticResource IconButton}"
                    ToolTipProperties.Text="{loc:Translate Action_Search}" />
                <ImageButton
                    Grid.Column="2"
                    behaviors:IconTint.Color="{DynamicResource TabBarSelectedColor}"
                    Command="{Binding ClearSearchCommand}"
                    SemanticProperties.Description="{loc:Translate Search_Clear}"
                    Source="ic_clear.png"
                    Style="{StaticResource IconButton}"
                    ToolTipProperties.Text="{loc:Translate Search_Clear}" />
            </Grid>

            <!--  Active filters, compact  -->
            <Border
                Grid.Row="2"
                Margin="16,8,16,0"
                Padding="10,6"
                IsVisible="{Binding ShowFilterBar}"
                Style="{StaticResource TocadiscosPanel}">
                <FlexLayout AlignItems="Center" JustifyContent="SpaceBetween" Wrap="Wrap">
                    <VerticalStackLayout
                        FlexLayout.Grow="1"
                        IsVisible="{Binding FiltersApplied}"
                        VerticalOptions="Center">
                        <Label Style="{StaticResource StationNameLabel}" Text="{loc:Translate Inicio_FiltersOn}" />
                        <Label Style="{StaticResource SecondaryLabel}" Text="{Binding FilterSummary}" />
                    </VerticalStackLayout>
                    <Label
                        FlexLayout.Grow="1"
                        IsVisible="{Binding FiltersNotApplied}"
                        Style="{StaticResource StationNameLabel}"
                        Text="{loc:Translate Inicio_FiltersOff}"
                        VerticalOptions="Center" />
                    <Button
                        Command="{Binding DeactivateFiltersCommand}"
                        IsVisible="{Binding FiltersApplied}"
                        Text="{loc:Translate Action_Disable}"
                        VerticalOptions="Center" />
                    <Button
                        Command="{Binding ActivateFiltersCommand}"
                        IsVisible="{Binding FiltersNotApplied}"
                        Text="{loc:Translate Action_Enable}"
                        VerticalOptions="Center" />
                </FlexLayout>
            </Border>

            <!--  Main area: the sleeve stack and the information panel  -->
            <Grid
                Grid.Row="3">
                <!--  The stack and the panel side by side when they fit, one under the other when not  -->
                <ScrollView>
                    <FlexLayout
                        Padding="8,4"
                        AlignContent="Center"
                        AlignItems="Center"
                        JustifyContent="Center"
                        Wrap="Wrap">
                        <controls:AspectBox Margin="8" MaxWidth="{DynamicResource BigSleeveMaxWidth}" MinWidth="{DynamicResource BigSleeveMinWidth}" Ratio="{DynamicResource BigSleeveRatio}">
                            <controls:SleeveStack
                                x:Name="Stack"
                                ActivateCommand="{Binding PlayHereCommand}"
                                FocusOnReset="First"
                                ItemDisplayPath="Station.Name"
                                ItemTemplate="{StaticResource StationCardTemplate}"
                                ItemsSource="{Binding Stations}" />
                        </controls:AspectBox>
                        <controls:SizeLimit
                            x:DataType="vm:StationListItem"
                            BindingContext="{Binding FocusedItem, Source={x:Reference Stack}, x:DataType=controls:SleeveStack}"
                            IsVisible="{Binding HasFocusedItem, Source={x:Reference Stack}, x:DataType=controls:SleeveStack}"
                            Margin="8"
                            MaxWidth="{DynamicResource PlayerPanelMaxWidth}"
                            MinWidth="{DynamicResource PlayerPanelMinWidth}">
                            <Border Style="{StaticResource TocadiscosPanel}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                        <Label
                                            Grid.Column="0"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="3"
                                            Style="{StaticResource StationNameLabel}"
                                            Text="{Binding Station.Name}"
                                            VerticalOptions="Center" />
                                        <ImageButton
                                            Grid.Column="1"
                                            behaviors:IconTint.Color="{DynamicResource FavoriteIconColor}"
                                            Command="{Binding HeartCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource IconButton}"
                                            VerticalOptions="Start">
                                            <ImageButton.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsFavorite}"
                                                    TargetType="ImageButton"
                                                    Value="False">
                                                    <Setter Property="Source" Value="ic_heart_outline.png" />
                                                    <Setter Property="SemanticProperties.Description" Value="{loc:Translate Action_AddFavorite}" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding IsFavorite}"
                                                    TargetType="ImageButton"
                                                    Value="True">
                                                    <Setter Property="Source" Value="ic_heart.png" />
                                                    <Setter Property="SemanticProperties.Description" Value="{loc:Translate Action_RemoveFavorite}" />
                                                </DataTrigger>
                                            </ImageButton.Triggers>
                                        </ImageButton>
                                    </Grid>
                                    <Label Style="{StaticResource SecondaryLabel}" Text="{Binding Details}" />
                                    <Label
                                        IsVisible="{Binding IsSelected}"
                                        FontAttributes="Bold"
                                        FontFamily="{DynamicResource AppFontFamilyBold}"
                                        Text="{Binding PlaybackStatusText, Source={RelativeSource AncestorType={x:Type vm:InicioViewModel}}, x:DataType=vm:InicioViewModel}"
                                        TextColor="{DynamicResource TabBarSelectedColor}" />
                                </VerticalStackLayout>
                            </Border>
                        </controls:SizeLimit>
                    </FlexLayout>
                </ScrollView>


                <!--  States, in place of the stack  -->
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsLoading}"
                    Spacing="8"
                    VerticalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsLoading}" />
                    <Label Style="{StaticResource SecondaryLabel}" Text="{loc:Translate Inicio_Loading}" />
                </VerticalStackLayout>

                <Label
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding IsEmptyPlain}"
                    Style="{StaticResource SecondaryLabel}"
                    Text="{loc:Translate Inicio_NoStations}"
                    VerticalOptions="Center" />

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsEmptyWithPreferences}"
                    Spacing="12"
                    VerticalOptions="Center">
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SecondaryLabel}"
                        Text="{loc:Translate Inicio_NoStationsFiltered}" />
                    <Button
                        Command="{Binding DeactivateFiltersCommand}"
                        HorizontalOptions="Center"
                        Text="{loc:Translate Action_Disable}" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasError}"
                    Spacing="12"
                    VerticalOptions="Center">
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource ErrorLabel}"
                        Text="{Binding ErrorMessage}" />
                    <Button
                        Command="{Binding RetryCommand}"
                        HorizontalOptions="Center"
                        Text="{loc:Translate Action_Retry}" />
                </VerticalStackLayout>
            </Grid>

            <views:BottomBar Grid.Row="4" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="FavoritosTemplate">
        <Grid
            x:DataType="vm:FavoritosViewModel"
            BackgroundColor="{DynamicResource PageBackgroundColor}"
            BindingContext="{Binding BindingContext, Source={RelativeSource TemplatedParent}, x:DataType=ContentPage}"
            RowDefinitions="Auto,Auto,*,Auto">
            <ContentView Grid.Row="0" ControlTemplate="{StaticResource HeaderTemplate}" />

            <!--  Logged in: compact account row  -->
            <Grid
                Grid.Row="1"
                Padding="16,8,16,0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8"
                IsVisible="{Binding IsLoggedIn}">
                <Label
                    Grid.Column="0"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Style="{StaticResource SecondaryLabel}"
                    Text="{Binding Email}"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="1"
                    Padding="12,4"
                    Command="{Binding LogOutCommand}"
                    Text="{loc:Translate Session_LogOut}" />
            </Grid>

            <!--  Logged out  -->
            <VerticalStackLayout
                Grid.Row="2"
                HorizontalOptions="Center"
                IsVisible="{Binding IsLoggedOut}"
                Spacing="12"
                VerticalOptions="Center">
                <Label HorizontalTextAlignment="Center" Text="{loc:Translate Favoritos_LogInHintSentence}" />
                <Button
                    Command="{Binding LogInCommand}"
                    HorizontalOptions="Center"
                    Text="{loc:Translate Page_Login}" />
            </VerticalStackLayout>

            <!--  Logged in: the sleeve stack, the information panel and the states  -->
            <Grid
                Grid.Row="2"
                IsVisible="{Binding IsLoggedIn}">
                <!--  The stack and the panel side by side when they fit, one under the other when not  -->
                <ScrollView>
                    <FlexLayout
                        Padding="8,4"
                        AlignContent="Center"
                        AlignItems="Center"
                        JustifyContent="Center"
                        Wrap="Wrap">
                        <controls:AspectBox Margin="8" MaxWidth="{DynamicResource BigSleeveMaxWidth}" MinWidth="{DynamicResource BigSleeveMinWidth}" Ratio="{DynamicResource BigSleeveRatio}">
                            <controls:SleeveStack
                                x:Name="Stack"
                                ActivateCommand="{Binding PlayHereCommand}"
                                FocusOnReset="KeepPosition"
                                ItemDisplayPath="Station.Name"
                                ItemTemplate="{StaticResource StationCardTemplate}"
                                ItemsSource="{Binding Stations}" />
                        </controls:AspectBox>
                        <controls:SizeLimit
                            x:DataType="vm:StationListItem"
                            BindingContext="{Binding FocusedItem, Source={x:Reference Stack}, x:DataType=controls:SleeveStack}"
                            IsVisible="{Binding HasFocusedItem, Source={x:Reference Stack}, x:DataType=controls:SleeveStack}"
                            Margin="8"
                            MaxWidth="{DynamicResource PlayerPanelMaxWidth}"
                            MinWidth="{DynamicResource PlayerPanelMinWidth}">
                            <Border Style="{StaticResource TocadiscosPanel}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                        <Label
                                            Grid.Column="0"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="3"
                                            Style="{StaticResource StationNameLabel}"
                                            Text="{Binding Station.Name}"
                                            VerticalOptions="Center" />
                                        <ImageButton
                                            Grid.Column="1"
                                            behaviors:IconTint.Color="{DynamicResource FavoriteIconColor}"
                                            Command="{Binding HeartCommand}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="{loc:Translate Action_RemoveFavorite}"
                                            Source="ic_heart.png"
                                            Style="{StaticResource IconButton}"
                                            VerticalOptions="Start" />
                                    </Grid>
                                    <Label Style="{StaticResource SecondaryLabel}" Text="{Binding Details}" />
                                    <Label
                                        IsVisible="{Binding IsSelected}"
                                        FontAttributes="Bold"
                                        FontFamily="{DynamicResource AppFontFamilyBold}"
                                        Text="{Binding PlaybackStatusText, Source={RelativeSource AncestorType={x:Type vm:FavoritosViewModel}}, x:DataType=vm:FavoritosViewModel}"
                                        TextColor="{DynamicResource TabBarSelectedColor}" />
                                </VerticalStackLayout>
                            </Border>
                        </controls:SizeLimit>
                    </FlexLayout>
                </ScrollView>


                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsLoading}"
                    Spacing="8"
                    VerticalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsLoading}" />
                    <Label Style="{StaticResource SecondaryLabel}" Text="{loc:Translate Favoritos_Loading}" />
                </VerticalStackLayout>

                <Label
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding IsEmpty}"
                    Style="{StaticResource SecondaryLabel}"
                    Text="{loc:Translate Favoritos_Empty}"
                    VerticalOptions="Center" />

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasError}"
                    Spacing="12"
                    VerticalOptions="Center">
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource ErrorLabel}"
                        Text="{Binding ErrorMessage}" />
                    <Button
                        Command="{Binding RetryCommand}"
                        HorizontalOptions="Center"
                        Text="{loc:Translate Action_Retry}" />
                </VerticalStackLayout>
            </Grid>

            <views:BottomBar Grid.Row="3" />
        </Grid>
    </ControlTemplate>

    <!--
        Reproductor: header with the house, the turntable (record and tonearm) with the information panel and the status
        line, and the record crate at the bottom instead of the bottom bar. The audio player is not here: it belongs to
        the window.
    -->
    <ControlTemplate x:Key="ReproductorTemplate">
        <Grid
            x:DataType="vm:ReproductorViewModel"
            BackgroundColor="{DynamicResource PageBackgroundColor}"
            BindingContext="{Binding BindingContext, Source={RelativeSource TemplatedParent}, x:DataType=ContentPage}"
            RowDefinitions="Auto,*">
            <ContentView Grid.Row="0" ControlTemplate="{StaticResource ReproductorHeaderTemplate}" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="8,4" Spacing="8">
                    <!--  The turntable and the panel side by side when they fit, one under the other when not  -->
                    <FlexLayout AlignItems="Center" JustifyContent="Center" Wrap="Wrap">
                        <controls:AspectBox
                            Margin="8"
                            MaxWidth="{DynamicResource TurntableMaxWidth}"
                            MinWidth="{DynamicResource TurntableMinWidth}"
                            Ratio="{DynamicResource TurntableRatio}">
                            <Grid>
                                <controls:VinylDisc
                                    IsBlank="{Binding HasNoStation}"
                                    IsSpinning="{Binding IsActive}"
                                    LogoSource="{Binding LogoUrl}" />
                                <controls:Tonearm
                                    Command="{Binding ToggleCommand}"
                                    IsEnabled="{Binding HasStation}"
                                    IsLowered="{Binding IsActive}" />
                            </Grid>
                        </controls:AspectBox>
                        <controls:SizeLimit
                            Margin="8"
                            MaxWidth="{DynamicResource PlayerPanelMaxWidth}"
                            MinWidth="{DynamicResource PlayerPanelMinWidth}">
                            <Border Style="{StaticResource TocadiscosPanel}">
                                <VerticalStackLayout Spacing="8">
                                    <Label
                                        IsVisible="{Binding HasNoStation}"
                                        Style="{StaticResource SecondaryLabel}"
                                        Text="{loc:Translate Reproductor_Choose}" />

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="4"
                                        IsVisible="{Binding HasStation}">
                                        <Label
                                            Grid.Column="0"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="3"
                                            Style="{StaticResource StationNameLabel}"
                                            Text="{Binding StationName}"
                                            VerticalOptions="Center" />
                                        <ImageButton
                                            Grid.Column="1"
                                            behaviors:IconTint.Color="{DynamicResource FavoriteIconColor}"
                                            Command="{Binding ToggleFavoriteCommand}"
                                            Style="{StaticResource IconButton}"
                                            VerticalOptions="Start">
                                            <ImageButton.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsFavorite}"
                                                    TargetType="ImageButton"
                                                    Value="False">
                                                    <Setter Property="Source" Value="ic_heart_outline.png" />
                                                    <Setter Property="SemanticProperties.Description" Value="{loc:Translate Action_AddFavorite}" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding IsFavorite}"
                                                    TargetType="ImageButton"
                                                    Value="True">
                                                    <Setter Property="Source" Value="ic_heart.png" />
                                                    <Setter Property="SemanticProperties.Description" Value="{loc:Translate Action_RemoveFavorite}" />
                                                </DataTrigger>
                                            </ImageButton.Triggers>
                                        </ImageButton>
                                    </Grid>
                                    <Label
                                        IsVisible="{Binding HasDetails}"
                                        Style="{StaticResource SecondaryLabel}"
                                        Text="{Binding Details}" />

                                    <!--  Status line  -->
                                    <Label
                                        IsVisible="{Binding HasStation}"
                                        FontAttributes="Bold"
                                        FontFamily="{DynamicResource AppFontFamilyBold}"
                                        Text="{Binding StatusText}"
                                        TextColor="{DynamicResource TabBarSelectedColor}" />
                                    <Label
                                        IsVisible="{Binding HasError}"
                                        Style="{StaticResource ErrorLabel}"
                                        Text="{Binding ErrorMessage}" />
                                    <Button
                                        Command="{Binding RetryCommand}"
                                        HorizontalOptions="Start"
                                        IsVisible="{Binding HasError}"
                                        Text="{loc:Translate Action_Retry}" />
                                </VerticalStackLayout>
                            </Border>
                        </controls:SizeLimit>
                    </FlexLayout>
                    <controls:AspectBox
                        MaxWidth="{DynamicResource RecordCrateMaxWidth}"
                        MinWidth="{DynamicResource RecordCrateMinWidth}"
                        Ratio="{DynamicResource RecordCrateRatio}">
                        <controls:RecordCrate
                            EmptyText="{loc:Translate Favoritos_Empty}"
                            IsLoggedIn="{Binding IsLoggedIn}"
                            ItemDisplayPath="Station.Name"
                            ItemIsCurrentPath="IsSelected"
                            ItemTemplate="{StaticResource CrateRecordTemplate}"
                            ItemsSource="{Binding Favorites}"
                            LogInCommand="{Binding LogInCommand}"
                            LoggedOutText="{loc:Translate Favoritos_LogInHint}"
                            SelectCommand="{Binding SelectFavoriteCommand}" />
                    </controls:AspectBox>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
