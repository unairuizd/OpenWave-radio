<?xml version="1.0" encoding="UTF-8" ?>
<!--
    "Blanco" theme: white background, near-black text. Every theme file defines exactly the same colour
    keys; styles read them with DynamicResource, so swapping the theme dictionary recolours the app at once.
-->
<ResourceDictionary
    x:Class="OpenWave.App.Resources.Themes.WhiteTheme"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Pages and surfaces -->
    <Color x:Key="PageBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="InputBackgroundColor">#F2F2F5</Color>
    <Color x:Key="DividerColor">#D6D6DE</Color>
    <Color x:Key="SelectedItemBackgroundColor">#E4E9FB</Color>

    <!-- Text -->
    <Color x:Key="PrimaryTextColor">#141418</Color>
    <Color x:Key="SecondaryTextColor">#5A5A66</Color>
    <Color x:Key="ErrorTextColor">#B3261E</Color>

    <!-- Accent: buttons, selection outline, heart -->
    <Color x:Key="AccentColor">#3A5BD9</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="FavoriteIconColor">#3A5BD9</Color>

    <!-- Tab bar -->
    <Color x:Key="TabBarBackgroundColor">#F7F7FA</Color>
    <Color x:Key="TabBarSelectedColor">#3A5BD9</Color>
    <Color x:Key="TabBarUnselectedColor">#5A5A66</Color>

</ResourceDictionary>
