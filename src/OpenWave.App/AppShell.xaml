<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OpenWave.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:OpenWave.App.Services.Localization"
    xmlns:views="clr-namespace:OpenWave.App.Views"
    Title="OpenWave"
    FlyoutBehavior="Disabled"
    Shell.TabBarIsVisible="False">

    <!--  The three sections give the //inicio, //reproductor and //favoritos routes. The native tab bar is never
          shown: every themed page draws its own bottom bar (Resources/Themes), and Ajustes is a pushed route.  -->

    <TabBar>
        <ShellContent
            Title="{loc:Translate Nav_Inicio}"
            Route="inicio"
            ContentTemplate="{DataTemplate views:InicioPage}" />
        <ShellContent
            Title="{loc:Translate Nav_Reproductor}"
            Route="reproductor"
            ContentTemplate="{DataTemplate views:ReproductorPage}" />
        <ShellContent
            Title="{loc:Translate Nav_Favoritos}"
            Route="favoritos"
            ContentTemplate="{DataTemplate views:FavoritosPage}" />
    </TabBar>

</Shell>
